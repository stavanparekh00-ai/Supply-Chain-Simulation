# Copy this file to .env.local for local development, and set the same
# variable in your Vercel project's Environment Variables for production.
#
# Get this connection string from your Neon project dashboard
# (neon.tech -> your project -> Connection Details -> "Pooled connection" string).
# It works as a standard Postgres connection string, so the same code path
# is used for local Postgres during development and Neon in production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
