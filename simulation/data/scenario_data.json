  "disruption_schedule": [
    {
      "week": 4,
      "type": "tariff_spike",
      "target_supplier_id": "overseas_manufacturer",
      "effect": {
        "tariff_pct_override": 100
      },
      "description": "Overseas Manufacturer's tariff jumps to 100% this week, raising landed cost from $12 to $24 per unit."
    },
    {
      "week": 6,
      "type": "supplier_partial_fill",
      "target_supplier_id": "overseas_manufacturer",
      "effect": {
        "fill_rate": 0.4
      },
      "description": "Overseas Manufacturer can deliver only 40% of orders arriving this week (partial fulfillment shortfall). The undelivered balance does not arrive."
    },
    {
      "week": 9,
      "type": "supplier_capacity_cut",
      "target_supplier_id": "overseas_manufacturer",
      "effect": {
        "capacity_multiplier": 0.5
      },
      "description": "Overseas Manufacturer's order capacity at every facility is cut by 50% for this week only."
    }
  ],
